# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local to git.

# Supabase project URL (safe to expose — it's in the JS bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose — protected by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Supabase service role key — SERVER-SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Project ref (used by supabase CLI)
SUPABASE_PROJECT_REF=your-project-ref
